# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# OpenAI — used for moderation, the LLM, text-to-speech (gpt-4o-mini-tts) and Whisper alignment
AI_MODEL_API_KEY=your-openai-api-key

# Google Gemini — used for Veo video generation
GEMINI_API_KEY=your-gemini-api-key

# LangSmith (optional) — tracing for the LangGraph pipeline
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-video
